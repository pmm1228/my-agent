WEB_PAGE_MAX_BYTES=1000000
WEB_ALLOWED_PROXY_CIDRS=

CHECKPOINTER_TYPE=memory
HTTP_TIMEOUT=15
API_HOST=0.0.0.0
API_PORT=8000
