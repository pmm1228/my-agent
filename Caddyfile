:8080 {
    reverse_proxy api:8000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Forwarded-Proto "{scheme}"
        -Server
    }

    handle /healthz {
        respond "ok" 200
    }

    log {
        output stdout
        format json
    }
}
